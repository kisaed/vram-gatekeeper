{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the settings window may do: call the app's own listed commands, listen to events, and open file dialogs. No filesystem, shell or network access from JavaScript.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "allow-get-status",
    "allow-get-startup",
    "allow-get-config",
    "allow-save-config",
    "allow-validate-config",
    "allow-get-param-catalog",
    "allow-refresh-catalog",
    "allow-preview-launch",
    "allow-load-model",
    "allow-unload-model",
    "allow-restart-model",
    "allow-unload-all",
    "allow-allow-anyway",
    "allow-release-hold",
    "allow-set-paused",
    "allow-list-running-processes",
    "allow-check-game-executable",
    "allow-default-browse-dir",
    "allow-list-gpu-adapters",
    "allow-set-api-key",
    "allow-secret-is-set",
    "allow-set-secret",
    "allow-clear-secret",
    "allow-get-logs",
    "allow-open-config-folder",
    "allow-test-load",
    "allow-check-engine-update",
    "allow-check-model-updates",
    "allow-install-engine",
    "allow-engine-install-progress",
    "allow-list-installed-engines",
    "allow-switch-engine",
    "allow-export-diagnostics",
    "allow-hf-search",
    "allow-hf-repo",
    "allow-download-enqueue",
    "allow-download-pause",
    "allow-download-resume",
    "allow-download-cancel",
    "allow-download-dismiss",
    "allow-download-list",
    "allow-library-list",
    "allow-library-delete",
    "allow-add-downloaded-model",
    "allow-add-downloaded-draft",
    "allow-find-draft-models",
    "allow-gguf-summary",
    "allow-speculative-memory"
  ]
}
